# Variables de entorno para ConectaResto-MVP
# Copiar este archivo a .env y completar los valores reales.
# El archivo .env está en .gitignore y no se sube al repositorio.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambiar-por-una-clave-secreta-real
# URL base de la SPA independiente para los QR y las redirecciones de QR antiguos.
# Para la demo local, sirve el frontend oficial en el puerto 8000.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=mysql+pymysql://root:contraseña@localhost:3306/conectaresto_flask_test