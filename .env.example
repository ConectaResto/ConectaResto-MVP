# Configuración de entorno para ConectaResto-MVP
# Copiar este archivo a .env y completar los valores reales.
# No subir .env al control de versiones.

FLASK_ENV=development
SECRET_KEY=cambiar-clave-secreta-en-produccion
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/conecta_resto
TEST_DATABASE_URL=sqlite:///:memory: